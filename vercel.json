{
  "version": 2,
  "buildCommand": "cd api && npm install && cd ../web/app && npm install && npm run build",
  "outputDirectory": "web/app/dist",
  "installCommand": "cd api && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/src/vercel.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}