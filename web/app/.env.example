# Frontend Environment Variables
# Copy to .env and fill in your values

# API URL (for production, set to your Vercel API URL)
VITE_API_URL=http://localhost:3001

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
VITE_STRIPE_PRICE_30_DAYS=price_your_30_days_price
VITE_STRIPE_PRICE_365_DAYS=price_your_365_days_price
VITE_STRIPE_PRICE_SESSION=price_your_session_price
VITE_STRIPE_PRICE_EXAM=price_your_exam_price